{
  "routes": {
    "netbox": {
      "upstream": "https://netbox.example.com",
      "env": "NETBOX_TOKEN",
      "auth": "token",
      "allow": ["GET /api/*"]
    },
    "internal-api": {
      "upstream": "https://api.internal.example.com",
      "env": "INTERNAL_API_KEY",
      "auth": "header:X-Auth-Token"
    },
    "vm-netbox": {
      "upstream": "http://192.168.1.50:8000",
      "env": "NETBOX_VM_TOKEN",
      "auth": "token",
      "allow_http": true
    },
    "local-gateway": {
      "upstream": "http://127.0.0.1:4000",
      "env": "GATEWAY_KEY",
      "auth": "bearer"
    }
  }
}
